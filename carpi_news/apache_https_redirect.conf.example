# Apache Configuration Example for Ombra del Portico
# Redirect HTTP to HTTPS and configure reverse proxy

# HTTP VirtualHost - Redirect all traffic to HTTPS
<VirtualHost *:80>
    ServerName ombradelportico.it
    ServerAlias www.ombradelportico.it

    # Redirect all HTTP traffic to HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]

    # Log files
    ErrorLog ${APACHE_LOG_DIR}/carpi-news-error.log
    CustomLog ${APACHE_LOG_DIR}/carpi-news-access.log combined
</VirtualHost>

# HTTPS VirtualHost - Main site configuration
<VirtualHost *:443>
    ServerName ombradelportico.it
    ServerAlias www.ombradelportico.it

    # SSL Configuration (Let's Encrypt)
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/ombradelportico.it/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/ombradelportico.it/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    # Security Headers
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Django Application (Gunicorn via Unix Socket)
    ProxyPreserveHost On
    ProxyPass /media !
    ProxyPass /static !
    ProxyPass / unix:/var/www/carpi-news/carpi_news.sock|http://ombradelportico.it/
    ProxyPassReverse / unix:/var/www/carpi-news/carpi_news.sock|http://ombradelportico.it/

    # Forward HTTPS header to Django
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    # Static Files
    Alias /static /var/www/carpi-news/carpi_news/staticfiles
    <Directory /var/www/carpi-news/carpi_news/staticfiles>
        Require all granted
        # Cache static files for 1 year
        ExpiresActive On
        ExpiresDefault "access plus 1 year"
    </Directory>

    # Media Files
    Alias /media /var/www/carpi-news/carpi_news/media
    <Directory /var/www/carpi-news/carpi_news/media>
        Require all granted
        # Cache media files for 1 month
        ExpiresActive On
        ExpiresDefault "access plus 1 month"
    </Directory>

    # Log Files
    ErrorLog ${APACHE_LOG_DIR}/carpi-news-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/carpi-news-ssl-access.log combined

    # Enable Compression
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
    </IfModule>
</VirtualHost>

# Required Apache Modules
# Enable with: sudo a2enmod ssl rewrite proxy proxy_http headers expires deflate

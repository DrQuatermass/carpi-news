# Django Configuration
DEBUG=True
SECRET_KEY=your-very-strong-secret-key-at-least-50-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Site URL for media files (used for local images)
SITE_URL=https://yourdomain.com

# Database (leave empty for SQLite, or use PostgreSQL for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Anthropic AI (Required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Search Engine Indexing (Optional but recommended)
# IndexNow: Multi-engine notification (Google, Bing, Yandex)
INDEXNOW_KEY=your-generated-indexnow-key-here

# Google Indexing API: Fast Google indexing
# Requires a Google Cloud Service Account JSON file
GOOGLE_INDEXING_CREDENTIALS=/path/to/google-service-account.json

# PayPal Payment Configuration (Required for banner payments)
PAYPAL_MODE=sandbox  # sandbox or live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email Configuration (Optional)
# Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=True

# Aruba Email (per domini Aruba)
# EMAIL_HOST=smtps.aruba.it
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your@yourdomain.com
# EMAIL_HOST_PASSWORD=your-email-password

ADMIN_EMAIL=redazione@ombradelportico.it

# YouTube Monitor (Optional)
YOUTUBE_MONITOR_ENABLED=True
YOUTUBE_PLAYLIST_ID=your-youtube-playlist-id
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHECK_INTERVAL=300

# Universal Monitors
UNIVERSAL_MONITORS_ENABLED=True
AUTO_START_MONITORS=False  # Imposta True in produzione per auto-start con Django

# Social Media Auto-Sharing (Optional)
# Facebook Page Sharing
FACEBOOK_AUTO_SHARE=False
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_ACCESS_TOKEN=your-facebook-page-access-token

# Facebook Story auto-publishing (oltre al post sulla Pagina)
# Quando True, alla approvazione dell'articolo viene generato un video
# verticale 1080x1920 con foto+titolo+CTA+musica e pubblicato come Storia.
# Richiede gli stessi permessi del posting Pagina (pages_manage_posts).
FACEBOOK_STORY_ENABLED=False
# Alias legacy: se True abilita comunque la Story, ma non pubblica piu' Reel.
FACEBOOK_REEL_ENABLED=False
FACEBOOK_REEL_DURATION=15
FACEBOOK_REEL_FPS=24
# Cartella con tracce royalty-free (MP3/WAV/M4A). Lascia vuoto per usare
# il pad ambient procedurale di fallback. Esempio: /var/www/carpi-news/carpi_news/media/reel_music
FACEBOOK_REEL_MUSIC_DIR=

# Instagram Story / Reel auto-publishing (oltre al post in feed IG)
# Stesso video verticale 1080x1920 con musica del Reel Facebook,
# pubblicato come Storia IG (24h) e/o Reel IG (permanente).
# Richiedono INSTAGRAM_AUTO_SHARE=True e le credenziali IG gia' configurate.
INSTAGRAM_STORY_ENABLED=False
INSTAGRAM_REEL_ENABLED=False
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_AUTO_DM_ACCEPT_ANY_EMOJI=True
INSTAGRAM_AUTO_DM_TEXT_TRIGGERS=LINK,INFO,LEGGI

# Metadati avanzati per discovery
# Facebook Place ID di Carpi (location tag su Reel e Storia, aumenta reach locale)
# Come trovarlo: https://developers.facebook.com/tools/explorer/ ->
# GET /pages/search?q=Carpi&type=place (cerca quello con location.city=Carpi)
CARPI_PLACE_ID=
# Nome dell'audio originale visualizzato sui Reel IG (branding playlist effect)
INSTAGRAM_REEL_AUDIO_NAME=Ombra del Portico - Notizie di Carpi

# Twitter/X Auto-Sharing
TWITTER_AUTO_SHARE=False
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Telegram Auto-Sharing
TELEGRAM_AUTO_SHARE=False
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Social Media Profile Scraping (Optional - for pubbliredazionali)
# Instagram Basic Display API (for extracting profile info)
# Requires Facebook Developer App: https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=

# Facebook Graph API (for extracting page info)
FACEBOOK_API_ACCESS_TOKEN=

# LinkedIn API (for extracting company info)
LINKEDIN_ACCESS_TOKEN=

# Email Monitor Configuration
EMAIL_MONITOR_ENABLED=True
EMAIL_COMUNICATI_PASSWORD=your-email-password-here
MONITOR_INTERVAL_EMAIL_COMUNICATI=300

# Intervalli di monitoraggio (in secondi)
MONITOR_INTERVAL_CARPI_CALCIO=900
MONITOR_INTERVAL_COMUNE_CARPI=1800
MONITOR_INTERVAL_YOUTUBE=600
MONITOR_INTERVAL_ANSA=3600
MONITOR_INTERVAL_EVENTI_CARPI=1800
MONITOR_INTERVAL_VOCE_CARPI=2400
MONITOR_INTERVAL_TEMPO_CARPI=2400
MONITOR_INTERVAL_QUESTURA_MODENA=600
MONITOR_INTERVAL_GENERIC_HTML=3600

# Media and Static Files
MEDIA_URL=/media/
STATIC_URL=/static/

# Security Settings (for production only)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
FACEBOOK_REEL_ENABLED=True
FACEBOOK_STORY_ENABLED=True
FACEBOOK_REEL_MUSIC_DIR=/var/www/carpi-news/carpi_news/media/reel_music
